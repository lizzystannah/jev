ODDS_API_REGIONS="eu" # eu, uk, us, au
ODDS_API_MARKETS="h2h,totals" # h2h (1X2) e totals (Over/Under 2.5) numa Ãºnica chamada
ODDS_API_CACHE_MINUTES="45" # Economia de quota: mantÃ©m dados em cache por 45 minutos (mÃ­nimo 15 min)
ODDS_API_SPORTS="soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_uefa_champs_league,soccer_uefa_europa_league" # Opcional: limite Ã s ligas que deseja acompanhar

# OPÃ‡ÃƒO 2: Football-Data.org API (https://football-data.org)
FOOTBALL_DATA_API_KEY=""

# OPÃ‡ÃƒO 3: Endpoint personalizado / API prÃ³pria de odds
MARKET_DATA_API_URL=""
MARKET_DATA_API_KEY=""

