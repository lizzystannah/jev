# ==============================================================================
# AGENDADOR DE FICHAS (bilhetes) â€” persistÃªncia + estoque automÃ¡tico
# O servidor cria/recompÃµe fichas sozinho, mesmo sem browser aberto.
# ==============================================================================
# BASE DE DADOS MYSQL â€” persistÃªncia das fichas (configurar tudo na env)
# Exemplo:
#   MYSQL_HOST="127.0.0.1"
#   MYSQL_PORT="3306"
#   MYSQL_USER="bilheteria"
#   MYSQL_PASSWORD="segredo"
#   MYSQL_DATABASE="bilheteria"
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
# Ligar SSL (1 = ligado). NecessÃ¡rio em muitos servidores geridos.
MYSQL_SSL=""
# Caminho do SQLite local de fallback (sÃ³ usado quando MYSQL_* estÃ¡ vazio).
# Local (dev): vazio = .data/bilheteria.db na raiz do projeto.
# Docker:      /data/bilheteria.db (dentro do volume nomeado bilheteria_data).
BILHETERIA_DB_PATH=""

# ==============================================================================
# PERSISTÃŠNCIA â€” onde ficam guardadas as fichas (bilhetes)
# ==============================================================================
# Duas opÃ§Ãµes (a primeira que estiver configurada ganha):
#   1) MySQL (recomendado em produÃ§Ã£o): preenche MYSQL_HOST, MYSQL_USER e
#      MYSQL_DATABASE (MYSQL_PORT/MYSQL_PASSWORD/MYSQL_SSL conforme o servidor).
#      As fichas vivem na base de dados e sobrevivem a qualquer restart/redeploy
#      do container, mesmo sem volume.
#   2) SQLite persistido em volume (default do docker-compose.yml): deixa as
#      MYSQL_* vazias e usa BILHETERIA_DB_PATH=/data/bilheteria.db. O volume
#      nomeado "bilheteria_data" Ã© o que preserva as fichas. "docker compose
#      down" mantÃ©m o volume; "docker compose down -v" APAGA todas as fichas.
# Sem MYSQL_* nem volume, o SQLite fica no sistema de ficheiros efÃ©mero do
# container: as fichas perdem-se em cada recriaÃ§Ã£o/redeploy.

# Estoque mÃ­nimo de fichas PENDENTES por horizonte (default: 4 / 4 / 4)
TICKETS_QUOTA_DIA="4"
TICKETS_QUOTA_MED="4"
TICKETS_QUOTA_LONGO="4"
# Alvo de odd combinada ("pontos") por tier. A ficha acrescenta jogos atÃ©
# chegar ao alvo, usando apenas as tips jÃ¡ calculadas para os jogos.
TICKETS_TARGET_SEGURA="3"
TICKETS_TARGET_MODERADA="15"
TICKETS_TARGET_OUSADA="100"
TICKETS_TARGET_MALUCA="250"
# Teto de jogos por ficha (o alvo manda no nÃºmero efetivo de pernas).
TICKETS_MAX_LEGS_SEGURA="12"
TICKETS_MAX_LEGS_MODERADA="18"
TICKETS_MAX_LEGS_OUSADA="26"
TICKETS_MAX_LEGS_MALUCA="8"
# Fichas de LONGO PRAZO: faixa de jogos por ficha (default 10 a 22). O alvo
# de odd continua a decidir quando parar, mas nunca abaixo do mÃ­nimo.
# DistribuiÃ§Ã£o por tier dentro da faixa: segura 10, moderada 14, ousada 18.
TICKETS_LONGO_MIN_LEGS="10"
TICKETS_LONGO_MAX_LEGS="22"
# Longo prazo Ã© mais rigoroso: probabilidade mÃ­nima da tip (%). 55 = faixa
# "mÃ©dia" do motor. A janela do longo Ã© hoje atÃ© +8 dias (nÃ£o sÃ³ 4+).
TICKETS_LONGO_MIN_PROB="55"
# Horas de tolerÃ¢ncia apÃ³s o Ãºltimo pontapÃ© antes de marcar a ficha como vencida
TICKETS_EXPIRY_GRACE_HOURS="6"
# Varredura de resultados de todos os jogos do dia (uma chamada matches?date=).
# As pernas das fichas pendentes sao verificadas a cada minuto, a parte. Inclui hoje e os 2 dias anteriores.
RESULTS_SWEEP_MINUTES="15"




# Segura/Moderada/Ousada usam apenas pernas com odd entre estes limites; a
# pontuacao alta vem de acumular jogos. A Maluca usa a faixa propria abaixo.
TICKETS_MIN_LEG_ODD="1.25"
TICKETS_MAX_LEG_ODD="2.2"
# Probabilidade minima (%) por perna nas fichas Segura/Moderada/Ousada.
TICKETS_NON_MALUCA_MIN_PROB="40"
# Maluca grounded: pernas entre 1.75x e 3.0x e probabilidade minima de 25%.
TICKETS_MALUCA_MIN_LEG_ODD="1.75"
TICKETS_MALUCA_MAX_LEG_ODD="3.0"
TICKETS_MALUCA_MIN_PROB="25"


# Anti-correlacao entre fichas: maximo de fichas pendentes com o mesmo jogo
# e maximo de jogos repetidos por ficha (sempre com tip/mercado diferente).
TICKETS_MAX_SLIPS_PER_MATCH="2"
TICKETS_MAX_REUSED_LEGS="8"

