# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MOTOR OPENROUTER (AnÃ¡lise TÃ¡tica opcional via openrouter/free)
# O motor de bilhetes usa o motor LOCAL AiScore (server/aiscoreEngine.ts) â€”
# nenhuma chave Ã© necessÃ¡ria para gerar bilhetes. OpenRouter/Gemini servem
# sÃ³ para a anÃ¡lise tÃ¡tica textual opcional (/api/ai/*).
# ==============================================================================
# Roteador gratuito de modelos do OpenRouter (sem custo): openrouter/free
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# ==============================================================================
# JEV (TypeSafe) — modelo de DECISÃO, não de linguagem natural.
# Usa a Decisions API (choice/noul/score), NÃO chat completions.
# As probabilidades continuam a ser calculadas pelo motor local; o JEV escolhe
# o mercado/tip de cada jogo.
# ==============================================================================
# Chave. Se JEV_API_KEY ficar vazio, usa OPENROUTER_API_KEY.
JEV_API_KEY=""
# Endpoint de decisões. Se ficar vazio usa o embutido:
#   https://openrouter.ai/api/alpha/decisions
# Aceita URL completa ou base (api, api/alpha ou raiz). JEV_DECISIONS_URL tem
# prioridade sobre JEV_API_URL.
JEV_DECISIONS_URL=""
JEV_API_URL=""
# Modelo de decisão (default typesafe/jev-1.14).
JEV_MODEL=""
# Timeout por chamada ao JEV (ms).
JEV_TIMEOUT_MS="60000"
# 1 (default) reutiliza decisões já guardadas enquanto as odds não mudarem;
# 0 força novas chamadas ao JEV em cada geração (mais custo, decisões frescas).
JEV_REUSE_DECISIONS="1"

# ==============================================================================
# REDIS (opcional) â€” cache de respostas para acelerar a navegaÃ§Ã£o entre abas.
# Requer o pacote: npm i redis
# Sem REDIS_URL (ou sem o pacote) o cache usa memÃ³ria do processo.
# ==============================================================================
REDIS_URL=""

# ==============================================================================
# THE ODDS API (https://the-odds-api.com)
# ==============================================================================
# Obtenha sua chave no dashboard oficial (https://the-odds-api.com/account/)
# Endpoints: /v4/sports e /v4/sports/{sport_key}/odds
ODDS_API_KEY=""
