# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MOTOR OPENROUTER (Análise Tática opcional via openrouter/free)
# O motor de bilhetes usa o motor LOCAL AiScore (server/aiscoreEngine.ts) —
# nenhuma chave é necessária para gerar bilhetes. OpenRouter/Gemini servem
# só para a análise tática textual opcional (/api/ai/*).
# ==============================================================================
# Roteador gratuito de modelos do OpenRouter (sem custo): openrouter/free
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# ==============================================================================
# THE ODDS API (https://the-odds-api.com)
# ==============================================================================
# Obtenha sua chave no dashboard oficial (https://the-odds-api.com/account/)
# Endpoints: /v4/sports e /v4/sports/{sport_key}/odds
ODDS_API_KEY=""
ODDS_API_HOST="https://api.the-odds-api.com"
ODDS_API_REGIONS="eu" # eu, uk, us, au
ODDS_API_MARKETS="h2h,totals" # h2h (1X2) e totals (Over/Under 2.5) numa única chamada
ODDS_API_CACHE_MINUTES="45" # Economia de quota: mantém dados em cache por 45 minutos (mínimo 15 min)
ODDS_API_SPORTS="soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_uefa_champs_league,soccer_uefa_europa_league" # Opcional: limite às ligas que deseja acompanhar

# OPÇÃO 2: Football-Data.org API (https://football-data.org)
FOOTBALL_DATA_API_KEY=""

# OPÇÃO 3: Endpoint personalizado / API própria de odds
MARKET_DATA_API_URL=""
MARKET_DATA_API_KEY=""

# ==============================================================================
# AISCORE (via Scraping/aiscore_bridge.py — curl_cffi, bypass Cloudflare)
# ==============================================================================
# Python do venv do workspace (curl_cffi chrome131). Vazio = auto-detect.
AISCORE_PYTHON="C:\\Users\\eliza\\Documents\\Scraping\\.venv312\\Scripts\\python.exe"

# ==============================================================================
# PREMIER BET (subir fichas: login + boletim + aposta)
# Necessita de Playwright + Chromium no Python:
#   pip install playwright && python -m playwright install chromium
# ==============================================================================
# Login da conta: telefone (244...), nome de utilizador ou email.
PREMIERBET_LOGIN=""
PREMIERBET_PASSWORD=""
# Python com playwright/curl_cffi. Vazio = usa AISCORE_PYTHON.
PREMIERBET_PYTHON=""
# 1 = mostra o browser (debug local); 0/esvazio = headless.
PREMIERBET_HEADFUL=""
# 1 = força modo de teste em TODOS os pedidos (preenche o boletim, não aposta).
PREMIERBET_DRY_RUN=""
# Valor sugerido no modal e limites aceites pela API (em Kwanzas/AOA).
PREMIERBET_DEFAULT_STAKE="1000"
PREMIERBET_MIN_STAKE="1"
PREMIERBET_MAX_STAKE=""
# Tempo máximo da automação (ms). Default: 300000 (5 min).
PREMIERBET_TIMEOUT_MS="300000"
# 1 = adiciona --no-sandbox ao Chromium (necessário em muitos contentores).
PREMIERBET_NO_SANDBOX=""

# ==============================================================================
# AGENDADOR DE FICHAS (bilhetes) — persistência + estoque automático
# O servidor cria/recompõe fichas sozinho, mesmo sem browser aberto.
# ==============================================================================
# BASE DE DADOS MYSQL — persistência das fichas (configurar tudo na env)
# Exemplo:
#   MYSQL_HOST="127.0.0.1"
#   MYSQL_PORT="3306"
#   MYSQL_USER="bilheteria"
#   MYSQL_PASSWORD="segredo"
#   MYSQL_DATABASE="bilheteria"
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
# Ligar SSL (1 = ligado). Necessário em muitos servidores geridos.
MYSQL_SSL=""
# Caminho do SQLite local de fallback (só usado quando MYSQL_* está vazio)
BILHETERIA_DB_PATH=""
# Estoque mínimo de fichas PENDENTES por horizonte (default: 3 / 3 / 2)
TICKETS_QUOTA_DIA="3"
TICKETS_QUOTA_MED="3"
TICKETS_QUOTA_LONGO="2"
# Horas de tolerância após o último pontapé antes de marcar a ficha como vencida
TICKETS_EXPIRY_GRACE_HOURS="6"

